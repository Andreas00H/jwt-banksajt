{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test:e2e": "playwright test",
    "e2e:up": "JWT_SECRET=$(openssl rand -hex 32) docker compose -f ../docker-compose.yml -f ../docker-compose.test.yml up -d --build --wait --wait-timeout 300",
    "e2e:down": "JWT_SECRET=bara-for-att-stanga-ner docker compose -f ../docker-compose.yml -f ../docker-compose.test.yml down --volumes"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
